f two players finish with the lowest score on a hole, each will receive one and a half points. The third player, finishing with the highest score, will receive no points. If all three players finish with the same score on a hole, each will receive one point.<\/p>\n<p>\u00a0<\/p>\n<p>If two or three teams are tied with the same amount of total points at the conclusion of play on Friday, a single individual will compete in a sudden death playoff to determine the winner.\u00a0\u00a0<\/p>\n<p>\u00a0<\/p>","background_switcher":"default","background_switcher_hover":"default","custom-responsive":"hide"}}]}],"mfn_global_section_id":""},{"uid":"1a47e486f","attr":{"scroll-visibility":"show","closeable-x":"left","query_post_orderby":"date","query_post_order":"ASC","query_terms_order":"ASC","query_slider_columns":{"desktop":"1","laptop":"1","tablet":"1","mobile":"1"},"background_switcher_ql":"default","query_display_slider_arrow_prev":"icon-left-open-big","query_display_slider_arrow_next":"icon-right-open-big","background_switcher":"default","background_switcher_hover":"default","background_switcher_scroll":"default","background_overlay_switcher":"default","custom_id":"leaderboard"},"wraps":[{"uid":"837aadb51","size":"1\/1","tablet_size":"1\/1","mobile_size":"1\/1","attr":{"query_post_orderby":"date","query_post_order":"ASC","query_terms_order":"ASC","query_slider_columns":{"desktop":"1","laptop":"1","tablet":"1","mobile":"1"},"background_switcher_ql":"default","query_display_slider_arrow_prev":"icon-left-open-big","query_display_slider_arrow_next":"icon-right-open-big","background_switcher":"default","background_switcher_hover":"default","background_overlay_switcher":"default","custom-responsive":"hide"},"items":[{"type":"column","uid":"2dbo9ovip","size":"1\/1","tablet_size":"1\/1","mobile_size":"1\/1","used_fonts":"","attr":{"content":"<h2 style=\"text-align: center;\">RESULTS AFTER DAY 1\u00a0<br \/>round 1<\/h2>","background_switcher":"default","background_switcher_hover":